        "# **Transaction Amount Analysis**"
      ],
      "metadata": {
        "id": "r65UCEWc2mL3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "fig, axes = plt.subplots(2,2, figsize = (15, 10))\n",
        "axes = axes.flatten()\n",
        "\n",
        "# Transaction amount distribution\n",
        "# 1) Kde plot\n",
        "sns.kdeplot(data = transaction_data[transaction_data['TransactionAmt'] < 500],x = 'TransactionAmt', hue = 'isFraud', fill = True, alpha = 0.2, ax = axes[0])\n",
        "axes[0].set_title('Transaction Amount Distribution')\n",
        "axes[0].set_xlabel('Transaction Amount')\n",
        "\n",
        "# 2) Box plot\n",
        "sns.boxplot(data = transaction_data[transaction_data['TransactionAmt'] < 500],x = 'isFraud', y = 'TransactionAmt', ax = axes[1])\n",
        "axes[1].set_title('Transaction Amount Distribution')\n",
        "axes[1].set_xticklabels(['Not Fraud', 'Fraud'])\n",
        "\n",
        "# 3) Violin Plot\n",
        "sns.violinplot(data = transaction_data[transaction_data['TransactionAmt'] < 500], x = 'isFraud', y = 'TransactionAmt', ax = axes[2])\n",
        "axes[2].set_title('Transaction Amount Distribution')\n",
        "axes[2].set_xticklabels(['Not Fraud', 'Fraud'])\n",
        "\n",
        "# 4) strip plot\n",
        "sns.stripplot(data = transaction_data[transaction_data['TransactionAmt'] < 500].sample(n = 5000, random_state=42), x = 'isFraud', y = 'TransactionAmt', ax = axes[3])\n",
        "axes[3].set_title('Transaction Amount Distribution')\n",
        "axes[3].set_xticklabels(['Not Fraud', 'Fraud'])\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print()\n",
        "print(f'Transaction Amount Statistics')\n",
        "transaction_data.groupby('isFraud')['TransactionAmt'].describe()\n"
      ],
